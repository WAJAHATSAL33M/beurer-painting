# --- Admin panel (set these in Vercel → Project → Settings → Environment Variables) ---
ADMIN_PASSWORD=choose-a-long-password
# Optional: any long random text. Defaults to the password if left out.
ADMIN_SECRET=
# Where edits are saved. Leave all four empty when running locally.
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=your-username/your-repo
GITHUB_BRANCH=main
# Only if the website is inside a sub-folder of the repo (e.g. "bauer-painting"), otherwise leave empty
GITHUB_CONTENT_DIR=
